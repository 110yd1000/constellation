[Unit]
Description=Media LAN captive portal
After=network-online.target
Wants=network-online.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/portal
EnvironmentFile=/etc/portal/portal.env
ExecStart=/opt/portal/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80 --no-server-header --no-access-log
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
