# /etc/portal/portal.env   (mode 640, owner root:portal)
# install.sh fills the first three secrets for you. LDAP_BIND_PASSWORD is the
# password of the "portal" account in LLDAP (phase 3, file portal-ldap).
SESSION_SECRET=
FERNET_KEY=
RADIUS_PASS=
LDAP_BIND_PASSWORD=

# Where things are (defaults match the design)
LDAP_URL=ldap://10.20.0.21:3890
LDAP_BASE=dc=media,dc=lan
LDAP_BIND_USER=portal
LLDAP_HTTP=http://10.20.0.21:17170
RADIUS_USER=radius
RADIUS_CLIENT_IP=10.20.0.21
HOTSPOT_LOGIN_URL=http://10.20.1.1/login
# Until phase 5 adds the dashboard, members land on the phase 3 test site
LANDING_MEMBER=https://test.media.lan
LANDING_GUEST=https://guest.media.lan
CA_FILE=/etc/portal/ca.crt
PORTAL_DB=/var/lib/portal/portal.db

# Devices allowed to open /admin without a live admin session (comma separated).
# 10.20.1.2 is the admin laptop bound in phase 2. Add 10.20.0.61/32 for remote admins
# who arrive through the Tailscale subnet router in LXC 106.
# A device that logged in to the Wi-Fi with an admin account is allowed automatically.
ADMIN_NETS=10.20.1.2/32

# Proxies whose X-Forwarded-For header is believed (Caddy in LXC 101)
TRUSTED_PROXIES=10.20.0.11
# Admin pages open only through Caddy (https://portal.media.lan), and the admin session
# cookie is sent only over HTTPS. Set to 0 only for troubleshooting.
ADMIN_VIA_PROXY=1
COOKIE_SECURE=1

# Tier limits (seconds); INTERNET_RATE is upload/download, e.g. 2M/4M
GUEST_SECONDS=7200
GUEST_IDLE=900
GUEST_PER_DAY=6
MEMBER_SECONDS=43200
MEMBER_IDLE=3600
INTERNET_RATE=

# Disconnect button on the Sessions page. Leave empty until the router REST user exists
# (phase 4, step 3). Example: ROUTER_URL=https://10.20.0.1
ROUTER_URL=
ROUTER_USER=portal
ROUTER_PASS=

# Phase 5: create Navidrome accounts on approval (leave empty until Navidrome runs)
NAVIDROME_URL=
NAVIDROME_ADMIN=
NAVIDROME_PASS=
